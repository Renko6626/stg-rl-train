#!/usr/bin/env bash
# dsh-flash 的替身：参数口径相同（--cwd --timeout --reasoning --log <prompt>），改用 Claude Code 无头模式跑一次性 worker。
# 用法：STG_DSH_BIN=transcribe/tools/claude-worker uv run python -m stgtranscribe.pipeline …
# 模型：STG_CLAUDE_MODEL（默认 sonnet）。最后一条回复打到 stdout（pipeline 落 .stdout），全过程另写 --log。
set -u
cwd=.; to=1800; log=/dev/null
while [ $# -gt 1 ]; do
  case "$1" in
    --cwd) cwd=$2; shift 2;;
    --timeout) to=$2; shift 2;;
    --reasoning) shift 2;;          # dsh 专用，Claude 这里不用
    --log) log=$2; shift 2;;
    --model) shift 2;;
    *) break;;
  esac
done
prompt=$1
cd "$cwd" || exit 2
mkdir -p "$(dirname "$log")"
# 瞬时网络错误（本机出网走代理，并发长会话偶尔被掐断）：退避后整次重跑，最多 4 次。
# 限额类错误不在这里重试——原样返回，由 pipeline 的 PROVIDER_FATAL 整批中止。
TRANSIENT='API Error: Connection|ECONNRESET|socket hang up|overloaded_error|API Error: 5[0-9][0-9]'
rc=1
for attempt in 1 2 3 4; do
  out=$(timeout "$to" claude -p --model "${STG_CLAUDE_MODEL:-sonnet}" --dangerously-skip-permissions \
    --output-format text "$prompt" 2>> "$log")
  rc=$?
  printf '%s\n' "$out" >> "$log"
  last=$(printf '%s\n' "$out" | tail -n 3)
  if [ "$rc" -ne 0 ] || printf '%s' "$last" | grep -Eq "^($TRANSIENT)|$TRANSIENT"; then
    if printf '%s' "$last" | grep -Eq "$TRANSIENT" && [ "$attempt" -lt 4 ]; then
      echo "[claude-worker] 瞬时错误，第 $attempt 次，$((30 * attempt * attempt)) 秒后重跑：$last" >> "$log"
      sleep $((30 * attempt * attempt)); continue
    fi
  fi
  break
done
printf '%s\n' "$out"
exit "$rc"
